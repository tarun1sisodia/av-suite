# SECURITY NOTICE (2026-11-10): Any secrets previously committed to this file have been REVOKED by the developer and are NO LONGER VALID. Do not use them.

# Application Environment Configuration
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001


# JWT Configuration for Token-Based Authentication
# JWT_SECRET_KEY should be a strong, randomly generated string (use: openssl rand -hex 32)
JWT_SECRET_KEY=your_secret_key_here_minimum_32_characters_recommended
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://localhost:6379

# Database Configuration - Supabase Session Pooler for IPv4 Support
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-ID]:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://[PROJECT-ID].supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
