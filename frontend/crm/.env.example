# AV Suite CRM — Environment Variables
# Copy this file to .env.local and fill in your values.

# Backend API base URL (no /api/v1 suffix — the app appends it)
# Example: http://localhost:8000 for local dev
# Example: https://api.yourdomain.com for production
NEXT_PUBLIC_API_URL=http://localhost:8000

# Integration Applications (Optional - defaults to localhost ports)
NEXT_PUBLIC_POSTURE_APP_URL=http://localhost:3002
NEXT_PUBLIC_EXERCISE_APP_URL=http://localhost:3001

# Cloudflare Turnstile CAPTCHA (Optional - for public booking form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Microsoft Clarity (Optional - session recordings & heatmaps)
# Get your project ID from https://clarity.microsoft.com
NEXT_PUBLIC_CLARITY_PROJECT_ID=
